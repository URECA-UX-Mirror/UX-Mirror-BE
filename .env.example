# 복사해서 .env 로 사용
# local: 이 PC에서 transformers로 직접 실행(개발용) / http: trida-stack serve_decide.py 서버(행사 GPU, 발표 수치용)
ZORO_BACKEND=local
ZORO_BASE_URL=http://localhost:30001
ZORO_TIMEOUT_S=30

ZORO_CHECKPOINT=C:\AI\Zoro-1
# cpu (bf16, 원본 가중치, 느림) | cuda-4bit (GTX 1660 6GB용 nf4 양자화, 빠르지만 확률이 원본과 다를 수 있음)
ZORO_DEVICE=cpu

# 모델 카드 보정값. Before/After 반드시 동일하게.
ZORO_TEMPERATURE=1.52

# 목표 도달 판정: DOM_ONLY | MODEL_AND_DOM. Before/After 반드시 동일하게.
# G0-A(2026-11-15) A10 실패 → 테스트 시나리오 규칙에 따라 DOM_ONLY.
GOAL_JUDGMENT_MODE=DOM_ONLY

# ---- 실행 API (api/main.py)
# Run 기록에 남는 모델 식별값. endpoint는 비밀 URL 대신 이름만 적는다.
ZORO_MODEL_VERSION=trillionlabs/Zoro-1
ZORO_ENDPOINT_ID=local
# 쇼핑몰 주소. after(개선안)는 고정 v2 없이 이 설정으로만 정한다 — 자동 개선 최종안 shop/moro-final("주문 환불")
# 띄우기: python shop/moro-final/server.py --port 8010. 비우면 after Run은 503(SITE_NOT_CONFIGURED)
SHOP_BEFORE_URL=http://127.0.0.1:8001
SHOP_AFTER_URL=http://127.0.0.1:8010
# 프론트 개발 서버 주소. 쉼표로 여러 개
UXM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 결과 폴더 (기본: 저장소의 results/)
# UXM_RESULTS_DIR=
