# 복사해서 .env 로 사용
# local: 이 PC에서 transformers로 직접 실행(개발용) / http: trida-stack serve_decide.py 서버(행사 GPU, 발표 수치용)
ZORO_BACKEND=local
ZORO_BASE_URL=http://localhost:30001
ZORO_TIMEOUT_S=30

ZORO_CHECKPOINT=C:\AI\Zoro-1
# cpu (bf16, 원본 가중치, 느림) | cuda-4bit (GTX 1660 6GB용 nf4 양자화, 빠르지만 확률이 원본과 다를 수 있음)
ZORO_DEVICE=cpu

# 모델 카드 보정값. Before/After 반드시 동일하게.
ZORO_TEMPERATURE=1.52

# 목표 도달 판정: DOM_ONLY | MODEL_AND_DOM. Before/After 반드시 동일하게.
# G0-A(2026-11-15) A10 실패 → 테스트 시나리오 규칙에 따라 DOM_ONLY.
GOAL_JUDGMENT_MODE=DOM_ONLY
