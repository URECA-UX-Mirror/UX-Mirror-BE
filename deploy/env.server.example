# 서버용 .env 예시. setup.sh가 저장소 루트에 .env가 없으면 이 파일을 복사한다. 실제 값은 저장소에 올리지 않는다.

# ---- 모델 (행사 GPU의 serve_decide.py)
ZORO_BACKEND=http
# GPU 서버 주소. SSH 터널이면 http://127.0.0.1:<터널 포트> (deploy/README.md "GPU 연결")
ZORO_BASE_URL=
ZORO_TIMEOUT_S=30

# 아래 4개는 E 실행·GPU 담당자의 .env와 반드시 같게 (다르면 비교·검증 조건이 달라진다)
ZORO_TEMPERATURE=1.52
GOAL_JUDGMENT_MODE=DOM_ONLY
ZORO_MODEL_VERSION=trillionlabs/Zoro-1
ZORO_ENDPOINT_ID=

# ---- 쇼핑몰 (deploy/run_shops.sh가 이 서버 안에서 띄움)
SHOP_BEFORE_URL=http://127.0.0.1:8001
# after(개선안) Run의 사이트. 고정 v2 없음 — 자동 개선 최종안(shop/moro-final, "주문 환불"). 비우면 after Run은 503
SHOP_AFTER_URL=http://127.0.0.1:8010
SHOP_C1_URL=http://127.0.0.1:8003
SHOP_C3_URL=http://127.0.0.1:8004
SHOP_C4_URL=http://127.0.0.1:8005
SHOP_C2_URL=http://127.0.0.1:8006

# ---- 프론트 주소 (Vercel production·preview). 쉼표로 여러 개
UXM_CORS_ORIGINS=https://ux-mirror-fe.vercel.app
